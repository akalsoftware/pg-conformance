{
  "name": "@akal/pg-conformance",
  "version": "0.0.15",
  "description": "A PostgreSQL schema fingerprint and DDL conformance corpus, shared by tools that need to agree on whether two schemas are the same.",
  "type": "module",
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": "./index.js",
    "./fingerprint.sql": "./fingerprint.sql",
    "./corpus/*.json": "./corpus/*.json"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "fingerprint.sql",
    "state.sql",
    "corpus",
    "src"
  ],
  "scripts": {
    "test": "node --test test/*.test.js"
  },
  "keywords": [
    "postgresql",
    "postgres",
    "schema",
    "migration",
    "diff",
    "conformance",
    "fingerprint"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/akalsoftware/pg-conformance.git"
  },
  "homepage": "https://github.com/akalsoftware/pg-conformance#readme",
  "bugs": {
    "url": "https://github.com/akalsoftware/pg-conformance/issues"
  },
  "engines": {
    "node": ">=18"
  }
}
